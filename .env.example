# ───────────────────────────────────────────────────────────────
# Prexacode · configuración de producción
# Copiar a .env y completar. NUNCA subir el .env a git.
# Para generar claves aleatorias:  openssl rand -hex 32
# ───────────────────────────────────────────────────────────────

# Dirección pública
APP_URL=https://sistema.prexacode.com
# Dirección de CoreDental (el mismo sistema, con la marca de CoreDental)
APP_URL_DENTAL=https://coredental.prexacode.com
# Puerto local donde escucha la app (nginx le pasa el tráfico). Solo accesible desde el servidor
PUERTO_APP=8010
# Solo si se usa Caddy en lugar de nginx (docker compose --profile caddy): dominio para el certificado
DOMINIO=sistema.prexacode.com

# Base de datos (la usa docker-compose para crear PostgreSQL)
POSTGRES_DB=prexacode
POSTGRES_USER=prexacode
POSTGRES_PASSWORD=cambiar-por-una-clave-larga

# Claves secretas (32+ caracteres aleatorios cada una)
JWT_SECRET=
# Cifra contraseñas de email y certificados de ARCA guardados. NO CAMBIARLA después de empezar a usar el sistema.
SECRETS_KEY=

# Tu usuario del panel de administración (/admin). Se crea solo la primera vez que arranca
ADMIN_EMAIL=hendl.martin@gmail.com
ADMIN_PASSWORD=cambiame-por-una-clave-larga

# Mercado Pago (cobro de suscripciones). Sin token, el pago es simulado: NO usar así con clientes reales.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Dólar fijo para cobrar (opcional). Si queda vacío, se usa el oficial del día.
TIPO_CAMBIO_USD=

# Correo de la plataforma (opcional): smtps://usuario:clave@smtp.proveedor.com:465
SMTP_URL=
EMAIL_FROM=notificaciones@prexacode.com.ar

# Copias de seguridad: cuántos días guardar
BACKUP_DIAS=14
